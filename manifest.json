{
  "id": "home-inventory",
  "name": "Home Inventory",
  "version": "1.1.0",
  "description": "A searchable record of your possessions for insurance and everyday use: photo, serial number, value, and — most usefully — where each item lives. Names and locations are searchable, so you can always find where you put things.",
  "entrypoint": "index.html",
  "runtime": "static",
  "icon": "📦",
  "category": "home",
  "tags": ["inventory", "insurance", "home", "belongings", "organization", "search"],
  "storage": "db",
  "preload": {
    "items": {"sql": "SELECT * FROM app_home_inventory__items ORDER BY name ASC"},
    "valuations": {"sql": "SELECT * FROM app_home_inventory__valuations ORDER BY recorded_at ASC"}
  },
  "db_plaintext_columns": ["name", "location", "category"],
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "automation_actions": {
    "add_item": {
      "title": "Catalogue an item",
      "description": "Add something to the home inventory when another app's event fires - a warranty registered, a purchase logged, equipment retired from the checkout list.",
      "params": {
        "created_by": { "type": "member", "label": "Catalogued by", "required": true },
        "name": { "type": "text", "label": "What it is", "required": true },
        "category": { "type": "text", "label": "Category", "default": "general" },
        "location": { "type": "text", "label": "Where it is", "default": "" }
      },
      "dedupe": { "table": "items", "column": "source_event_id" },
      "steps": [
        {
          "op": "insert",
          "table": "items",
          "values": {
            "id": "$uuid",
            "name": ":name",
            "category": ":category",
            "location": ":location",
            "created_by": ":created_by",
            "created_by_name": "Automation",
            "created_at": "$now",
            "updated_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "suggested_automations": [
    {
      "title": "Catalogue items registered for warranty",
      "description": "Something logged in the warranty vault is also something the household owns \u2014 it lands in the inventory with its category, so the insurance list and the warranty list do not have to be kept by hand in two places.",
      "trigger_event": "warranty.item_added",
      "target_app_id": "home-inventory",
      "action_id": "add_item",
      "param_map": {
        "created_by": { "kind": "payload_field", "value": "created_by" },
        "name": { "kind": "payload_field", "value": "name" },
        "category": { "kind": "payload_field", "value": "category" }
      }
    }
  ],
  "row_policies": {
    "items": {
      "kind": "adult_writable",
      "column_read_acls": {
        "serial": { "visible_to": ["adult"] }
      }
    },
    "valuations": { "kind": "adult_writable" }
  },
  "delete_cascades": {
    "items": [{ "table": "valuations", "foreign_key": "item_id" }]
  },
  "delete_file_columns": {
    "items": ["photo_id"]
  },
  "member_references": {
    "items": { "column": "created_by", "on_removed": "keep" },
    "valuations": { "column": "recorded_by", "on_removed": "keep" }
  },
  "publishes": ["home_inventory.item_added"],
  "publish_acls": {
    "home_inventory.item_added": { "require_role": "adult" }
  },
  "nav": { "label": "Inventory" },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS value FROM app_home_inventory__items LIMIT 1"
    },
    "display": { "template": "stat", "value": "value", "label": "items catalogued", "empty_hides": true }
  },
  "resource_limits": {
    "max_db_bytes": 52428800,
    "max_file_bytes": 10485760,
    "max_files_bytes": 524288000
  }
}
